{
  "lavs": "1.0",
  "name": "content-manager",
  "version": "1.0.0",
  "description": "视频内容运营素材管理服务，支持结构化数据存储、文本解析、内容审核、导出",

  "endpoints": [
    {
      "id": "listEntries",
      "method": "query",
      "description": "查询指定日期的所有素材条目，按 CID 分组返回",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/content-service.cjs", "list"],
        "input": "stdin",
        "timeout": 5000
      },
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "日期，格式 YYYY-MM-DD，默认当天"
            }
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "date": { "type": "string" },
            "entries": {
              "type": "array",
              "items": { "$ref": "#/types/ContentEntry" }
            },
            "total": { "type": "number" }
          }
        }
      }
    },
    {
      "id": "addEntries",
      "method": "mutation",
      "description": "批量添加素材条目",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/content-service.cjs", "add"],
        "input": "stdin",
        "timeout": 10000
      },
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "日期，格式 YYYY-MM-DD，默认当天"
            },
            "entries": {
              "type": "array",
              "description": "要添加的素材条目数组",
              "items": { "$ref": "#/types/ContentEntryInput" }
            }
          },
          "required": ["entries"]
        },
        "output": {
          "type": "object",
          "properties": {
            "added": { "type": "number" },
            "entries": {
              "type": "array",
              "items": { "$ref": "#/types/ContentEntry" }
            }
          }
        }
      }
    },
    {
      "id": "updateEntry",
      "method": "mutation",
      "description": "更新单条素材记录",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/content-service.cjs", "update"],
        "input": "stdin",
        "timeout": 5000
      },
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "date": { "type": "string", "description": "日期 YYYY-MM-DD" },
            "id": { "type": "string", "description": "条目 ID" },
            "updates": {
              "type": "object",
              "description": "要更新的字段键值对，如 {contentCheck: {shortHighlight: {passed: false, issues: [...]}}}",
              "additionalProperties": true
            }
          },
          "required": ["id", "updates"]
        },
        "output": { "$ref": "#/types/ContentEntry" }
      }
    },
    {
      "id": "deleteEntry",
      "method": "mutation",
      "description": "删除单条素材记录",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/content-service.cjs", "delete"],
        "input": "stdin",
        "timeout": 5000
      },
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "date": { "type": "string", "description": "日期 YYYY-MM-DD" },
            "id": { "type": "string", "description": "条目 ID" }
          },
          "required": ["id"]
        },
        "output": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" }
          }
        }
      }
    },
    {
      "id": "reorderCids",
      "method": "mutation",
      "description": "更新 CID 分组的排列顺序",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/content-service.cjs", "reorder"],
        "input": "stdin",
        "timeout": 5000
      },
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "date": { "type": "string", "description": "日期 YYYY-MM-DD" },
            "cidOrder": {
              "type": "array",
              "items": { "type": "string" },
              "description": "CID 的排列顺序数组"
            }
          },
          "required": ["cidOrder"]
        },
        "output": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" }
          }
        }
      }
    },
    {
      "id": "exportEntries",
      "method": "query",
      "description": "导出指定日期的素材数据为文本格式",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/content-service.cjs", "export"],
        "input": "stdin",
        "timeout": 10000
      },
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "date": { "type": "string", "description": "日期 YYYY-MM-DD" },
            "format": {
              "type": "string",
              "enum": ["text", "json"],
              "description": "导出格式，text 为还原的原始文本格式，json 为结构化数据"
            }
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "content": { "type": "string" },
            "format": { "type": "string" }
          }
        }
      }
    }
  ],

  "view": {
    "component": {
      "type": "local",
      "path": "view/index.html"
    },
    "fallback": "table",
    "icon": "table"
  },

  "types": {
    "ContentEntry": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cid": { "type": "string" },
        "showName": { "type": "string" },
        "title": { "type": "string" },
        "section": { "type": "string" },
        "updateTime": { "type": "string" },
        "shortHighlight": { "type": "string" },
        "longHighlight": { "type": "string" },
        "pcAutoPlay": { "type": "string" },
        "images": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "contentCheck": {
          "type": "object",
          "nullable": true
        },
        "order": { "type": "number" },
        "cidOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "cid", "showName", "title"]
    },
    "ContentEntryInput": {
      "type": "object",
      "properties": {
        "cid": { "type": "string" },
        "showName": { "type": "string" },
        "title": { "type": "string" },
        "section": { "type": "string" },
        "updateTime": { "type": "string" },
        "shortHighlight": { "type": "string" },
        "longHighlight": { "type": "string" },
        "pcAutoPlay": { "type": "string" },
        "images": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["cid", "showName", "title"]
    },
    "ContentIssue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["typo", "political", "sentiment", "other"],
          "description": "问题类型：错别字、政治风险、舆情风险、其他"
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "严重程度"
        },
        "description": {
          "type": "string",
          "description": "问题描述"
        }
      },
      "required": ["type", "severity", "description"]
    }
  },

  "permissions": {
    "fileAccess": ["./data/**/*.jsonl"],
    "networkAccess": true,
    "maxExecutionTime": 30000
  }
}
