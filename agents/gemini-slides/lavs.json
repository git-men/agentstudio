{
  "lavs": "1.0",
  "name": "gemini-slides",
  "version": "1.0.0",
  "description": "Gemini 智能 PPT - AI 演讲稿生成与编辑服务",
  "endpoints": [
    {
      "id": "getPresentation",
      "method": "query",
      "description": "获取当前演讲稿的完整数据",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/service.cjs", "get"],
        "input": "args"
      },
      "schema": {
        "output": { "$ref": "#/types/Presentation" }
      }
    },
    {
      "id": "listStyles",
      "method": "query",
      "description": "列出所有可用的幻灯片视觉风格",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/service.cjs", "list-styles"],
        "input": "args"
      },
      "schema": {
        "output": {
          "type": "array",
          "items": { "$ref": "#/types/Style" }
        }
      }
    },
    {
      "id": "getConfig",
      "method": "query",
      "description": "获取当前配置（API Key 状态、模型设置）",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/service.cjs", "get-config"],
        "input": "args"
      },
      "schema": {
        "output": {
          "type": "object",
          "properties": {
            "hasApiKey": { "type": "boolean" },
            "textModel": { "type": "string" },
            "imageModel": { "type": "string" }
          }
        }
      }
    },
    {
      "id": "setConfig",
      "method": "mutation",
      "description": "设置配置（Gemini API Key、模型等）",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/service.cjs", "set-config"],
        "input": "stdin"
      },
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "geminiApiKey": { "type": "string", "description": "Gemini API Key" },
            "textModel": { "type": "string", "description": "文本生成模型名称" },
            "imageModel": { "type": "string", "description": "图片生成模型名称" }
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "hasApiKey": { "type": "boolean" }
          }
        }
      }
    },
    {
      "id": "generateOutline",
      "method": "mutation",
      "description": "根据主题和需求生成演讲稿大纲（联网调研）",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/service.cjs", "generate-outline"],
        "input": "stdin"
      },
      "schema": {
        "input": {
          "type": "object",
          "required": ["topic"],
          "properties": {
            "topic": { "type": "string", "description": "演讲主题或需求描述" },
            "slideCount": { "type": "string", "description": "目标页数，如 8-12" },
            "styleId": { "type": "string", "description": "风格 ID" }
          }
        },
        "output": { "$ref": "#/types/Presentation" }
      }
    },
    {
      "id": "refineOutline",
      "method": "mutation",
      "description": "根据用户指令优化已有大纲",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/service.cjs", "refine-outline"],
        "input": "stdin"
      },
      "schema": {
        "input": {
          "type": "object",
          "required": ["instruction"],
          "properties": {
            "instruction": { "type": "string", "description": "优化指令" },
            "slideCount": { "type": "string", "description": "目标页数" }
          }
        },
        "output": { "$ref": "#/types/Presentation" }
      }
    },
    {
      "id": "updateSlide",
      "method": "mutation",
      "description": "更新指定幻灯片的内容",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/service.cjs", "update-slide"],
        "input": "stdin"
      },
      "schema": {
        "input": {
          "type": "object",
          "required": ["index"],
          "properties": {
            "index": { "type": "number", "description": "幻灯片索引（0-based）" },
            "title": { "type": "string" },
            "body": { "type": "array", "items": { "type": "string" } },
            "imageDescription": { "type": "string" },
            "layout": { "type": "string" },
            "speakerNotes": { "type": "string" }
          }
        },
        "output": { "$ref": "#/types/Presentation" }
      }
    },
    {
      "id": "addSlide",
      "method": "mutation",
      "description": "在指定位置添加新幻灯片",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/service.cjs", "add-slide"],
        "input": "stdin"
      },
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "index": { "type": "number", "description": "插入位置（不指定则末尾追加）" },
            "title": { "type": "string" },
            "body": { "type": "array", "items": { "type": "string" } },
            "imageDescription": { "type": "string" }
          }
        },
        "output": { "$ref": "#/types/Presentation" }
      }
    },
    {
      "id": "deleteSlide",
      "method": "mutation",
      "description": "删除指定幻灯片",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/service.cjs", "delete-slide"],
        "input": "stdin"
      },
      "schema": {
        "input": {
          "type": "object",
          "required": ["index"],
          "properties": {
            "index": { "type": "number", "description": "要删除的幻灯片索引" }
          }
        },
        "output": { "$ref": "#/types/Presentation" }
      }
    },
    {
      "id": "moveSlide",
      "method": "mutation",
      "description": "移动幻灯片位置",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/service.cjs", "move-slide"],
        "input": "stdin"
      },
      "schema": {
        "input": {
          "type": "object",
          "required": ["index", "direction"],
          "properties": {
            "index": { "type": "number" },
            "direction": { "type": "number", "description": "-1 上移, 1 下移" }
          }
        },
        "output": { "$ref": "#/types/Presentation" }
      }
    },
    {
      "id": "setStyle",
      "method": "mutation",
      "description": "设置幻灯片风格和分辨率",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/service.cjs", "set-style"],
        "input": "stdin"
      },
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "styleId": { "type": "string" },
            "resolution": { "type": "string", "enum": ["2K", "4K"] }
          }
        },
        "output": { "$ref": "#/types/Presentation" }
      }
    },
    {
      "id": "generateImage",
      "method": "mutation",
      "description": "为指定幻灯片生成 AI 图片",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/service.cjs", "generate-image"],
        "input": "stdin"
      },
      "schema": {
        "input": {
          "type": "object",
          "required": ["slideIndex"],
          "properties": {
            "slideIndex": { "type": "number", "description": "幻灯片索引" },
            "instruction": { "type": "string", "description": "视觉微调指令" },
            "useCurrentAsRef": { "type": "boolean", "description": "是否以当前图片为参考" }
          }
        },
        "output": { "$ref": "#/types/Presentation" }
      }
    },
    {
      "id": "generateAllImages",
      "method": "mutation",
      "description": "批量生成所有幻灯片图片",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/service.cjs", "generate-all-images"],
        "input": "stdin"
      },
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "startIndex": { "type": "number", "description": "起始索引（默认 0）" }
          }
        },
        "output": { "$ref": "#/types/Presentation" }
      }
    },
    {
      "id": "exportPresentation",
      "method": "mutation",
      "description": "导出演讲稿为 PPTX 或 PDF",
      "handler": {
        "type": "script",
        "command": "node",
        "args": ["scripts/service.cjs", "export"],
        "input": "stdin"
      },
      "schema": {
        "input": {
          "type": "object",
          "required": ["format"],
          "properties": {
            "format": { "type": "string", "enum": ["pptx", "pdf"], "description": "导出格式" }
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "filePath": { "type": "string" }
          }
        }
      }
    }
  ],
  "view": {
    "component": {
      "type": "local",
      "path": "view/dist/index.html"
    },
    "fallback": "list",
    "icon": "presentation"
  },
  "types": {
    "Presentation": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "userInput": { "type": "string" },
        "styleId": { "type": "string" },
        "resolution": { "type": "string" },
        "slides": { "type": "array", "items": { "$ref": "#/types/Slide" } },
        "sources": { "type": "array", "items": { "$ref": "#/types/Source" } },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "Slide": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "content": { "$ref": "#/types/SlideContent" },
        "imageUrl": { "type": "string" },
        "imageHistory": { "type": "array", "items": { "$ref": "#/types/ImageVersion" } }
      }
    },
    "SlideContent": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "array", "items": { "type": "string" } },
        "imageDescription": { "type": "string" },
        "layout": { "type": "string" },
        "speakerNotes": { "type": "string" }
      }
    },
    "ImageVersion": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "timestamp": { "type": "number" },
        "title": { "type": "string" },
        "body": { "type": "array", "items": { "type": "string" } },
        "userInstruction": { "type": "string" },
        "referenceImageUrl": { "type": "string" }
      }
    },
    "Source": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "uri": { "type": "string" }
      }
    },
    "Style": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "previewColor": { "type": "string" },
        "promptModifier": { "type": "string" }
      }
    }
  },
  "permissions": {
    "fileAccess": ["./data/**"],
    "networkAccess": true,
    "maxExecutionTime": 180000
  }
}
