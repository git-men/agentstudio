{
  "productName": "ClawStudio",
  "version": "0.1.14",
  "identifier": "com.clawstudio.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "node ../desktop/scripts/dev.mjs",
    "beforeBuildCommand": "node ../desktop/scripts/build.mjs"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/clawstudio-backend"],
    "macOS": {
      "entitlements": null,
      "signingIdentity": "-",
      "providerShortName": null
    },
    "windows": {
      "nsis": {}
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {}
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClawStudio",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false,
        "center": true,
        "decorations": true
      },
      {
        "label": "splashscreen",
        "title": "ClawStudio",
        "width": 400,
        "height": 300,
        "visible": true,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "url": "splashscreen.html"
      }
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFRURBN0QyOTYwRDBCMDUKUldRRkN3MlcwcWZ0bm1EeVJJTG16bFZVTlZRbGI3Ynk0OXlNUVl2YTZyUHJ5SjZwVWsxRmJqQzgK",
      "endpoints": [
        "https://static-76067.sz.gfp.tencent-cloud.com/clawstudio-desktop/latest.json"
      ]
    },
    "singleInstance": {}
  }
}
