{
  "name": "agentstudio-backend",
  "version": "0.4.2",
  "description": "Backend API for AgentStudio - AI-powered presentation editor with Claude integration",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "agentstudio": "dist/bin/agentstudio.js",
    "clawstudio": "dist/bin/clawstudio.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "cli": "tsx src/bin/agentstudio.ts",
    "admin": "tsx src/bin/agentstudio.ts admin",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --fix",
    "migrate-projects": "node scripts/migrate-projects.js",
    "upgrade-agents": "node scripts/upgrade-agents.js",
    "restore-agents": "node scripts/restore-agents.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.2.5",
    "@anthropic-ai/claude-agent-sdk": "^0.2.42",
